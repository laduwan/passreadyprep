# Copy this file to ".env" and fill in your real values.

PORT=4000

# Your MongoDB Atlas connection string
MONGO_URI=your-mongodb-atlas-connection-string

# A long random string — keeps sign-ins secure. Change it.
JWT_SECRET=change-this-to-a-long-random-string

# Where your frontend runs (for browser security). "*" allows all during early dev.
CLIENT_ORIGIN=*

# Admin API fallback. The admin pages sign in with per-person admin accounts
# (promote one at /admin-users.html), so nothing prompts for this any more —
# it only still works as an x-admin-token header for scripts and curl.
ADMIN_TOKEN=change-this-to-a-long-random-string

# Public base URL, used to build links in emails (e.g. password reset).
APP_URL=https://www.passreadyprep.com

# ── Email (Resend) ──────────────────────────────────────────────────
# PRP's Resend API key (Resend → API Keys). All email goes through Resend when
# it's set; MAIL_FROM_EMAIL's domain must be verified in Resend → Domains.
# Also used by the inbound-email webhook to fetch received messages.
# Not the same as RESEND_API_KEY below, which is CounselorReady's key.
PRP_RESEND_API_KEY=
# Brevo: sends email only while PRP_RESEND_API_KEY is unset (switch-over
# fallback), and always sends the optional SMS alerts below. With neither key
# set, emails are logged to the server console instead (nothing errors in dev).
BREVO_API_KEY=
MAIL_FROM_EMAIL=noreply@passreadyprep.com
MAIL_FROM_NAME=PassReady Prep

# ── Admin activity alerts ───────────────────────────────────────────
# Where activity/error alerts are emailed (defaults to MAIL_FROM_EMAIL).
ADMIN_ALERT_EMAIL=
# Optional SMS alerts via Brevo (needs SMS credits + registered sender).
# Phone in international format WITHOUT '+', e.g. 15551234567.
ADMIN_ALERT_SMS_TO=
SMS_SENDER=PassReady
# Comma list of event types to alert on (overrides the default set).
# Default alerts: user.registered, payment.succeeded, payment.failed,
# password.reset_completed — plus ALL errors, always.
ADMIN_ALERT_EVENTS=
# Set to 1 to silence all alerts (events are still logged to the panel).
ADMIN_ALERT_DISABLE=
# Minutes between alerts of the same kind, to avoid inbox floods (default 10).
ADMIN_ALERT_THROTTLE_MIN=10
# Optional: auto-delete activity events older than N days (unset = keep forever).
ACTIVITY_TTL_DAYS=

# ── Anonymous pageview counting ─────────────────────────────────────
# Salt for the one-way visitor hash the pageview log uses to estimate daily
# uniques. No raw IP is ever stored; this just makes the hash unguessable.
# Any long random string. Changing it resets unique counts from that day on.
VISIT_HASH_SALT=change-this-to-a-long-random-string
# Optional: auto-delete pageviews older than N days (unset = keep forever).
VISIT_TTL_DAYS=
# Optional: Google Analytics 4 measurement ID (G-XXXXXXX). Unset = no Google tag.
GA_MEASUREMENT_ID=

# ── Free trial ──────────────────────────────────────────────────────
# The STANDARD trial: days of full access from signup before the paywall,
# for everyone who hasn't been granted a longer one. Defaults to 3 if unset.
# Measured from the account's creation date, so changing it also changes
# existing accounts' trials, and the landing page states this number as
# separate copy — keep them in step. Longer trials for individual people
# (review swaps, comps) are granted per account in Admin → Subscribers,
# and are not affected by this.
TRIAL_DAYS=3

# Trial reminder emails (jobs/trialReminders.js): an "ends tomorrow" note and,
# after the trial lapses, an "it has ended" note — each sent at most once per
# account. They go out through the same mailer as everything else, so with
# no email key set they're logged to the console instead of sent.
# Set to 1 to stop sending them without a code change.
TRIAL_REMINDERS_DISABLE=

# Weekly blog auto-draft (jobs/blogAutoDraft.js): on Mondays, drafts the next
# topic from data/blogTopicQueue.js with ANTHROPIC_API_KEY and saves it as a
# DRAFT (never published) for review in Admin → Blog; the admin alert email
# says when one is ready. Set to 1 to stop it. BLOG_DRAFT_MODEL overrides the
# model (default claude-opus-5-5).
BLOG_AUTODRAFT_DISABLE=
BLOG_DRAFT_MODEL=

# ── Cross-promo to CounselorReady (jobs/broadcast-prp-crosspromo.js) ─
# One-off script that emails CR's user base about PassReady Prep. CR is a
# separate app with its own database and its own mail provider (Resend), so
# this needs its own connection string and API key — NOT this app's MONGO_URI
# or BREVO_API_KEY.
CR_MONGO_URI=
RESEND_API_KEY=
CR_MAIL_FROM=

# ── Inbound email (Resend Receiving → routes/inboundEmail.js) ─────
# Resend Dashboard → Webhooks → Add Webhook:
#   URL https://www.passreadyprep.com/api/inbound-email/webhook, event email.received
# Paste that webhook's signing secret here. Unset = the webhook refuses requests.
RESEND_WEBHOOK_SECRET=
# The email body is fetched with PRP_RESEND_API_KEY (Email section above);
# unset = forwards carry metadata only.
# Where received mail is forwarded (defaults to ADMIN_ALERT_EMAIL, then MAIL_FROM_EMAIL).
INBOUND_FORWARD_TO=

# ── AI (Anthropic / Claude) ──────────────────────────────────────────
# ANTHROPIC_API_KEY is the PRODUCTION key: the live server uses it for the
# AI debrief tutor (routes/coreTutor.js, routes/debrief.js), admin-triggered
# case generation (routes/adminGenerate.js), and the scheduled deep-case job
# (jobs/ncmhceCaseGen.js). Keep it on a Console key/workspace with a spend
# limit sized for that always-on traffic.
ANTHROPIC_API_KEY=
# Optional: model overrides.
ANTHROPIC_MODEL=
NCMHCE_GEN_MODEL=

# Optional, developer tooling only: overrides ANTHROPIC_API_KEY for the
# CLI bulk-generation scripts under tools/cases/ (generate-deep.js,
# fix-distractors.js, rewrite-questions.js — see tools/cases/anthropic.js).
# These are long, developer-run, Opus-heavy batches (a --series rewrite run
# can be hundreds of calls). Pointing them at their own Console key/workspace
# means a big local or Render-shell run can never eat into the production
# key's spend limit or rate limit. Leave unset to keep using ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY_CASE_TOOLS=

# ── NCE (National Counselor Examination) ────────────────────────────
# NCE is billed separately from NCMHCE (routes/payment.js → User.nceAccess).
# Create three prices in Stripe and paste their price IDs here:
#   monthly $24.99 recurring, 3-month $59 one-time, 6-month $89 one-time.
STRIPE_PRICE_NCE_MONTHLY=
STRIPE_PRICE_NCE_PASS3=
STRIPE_PRICE_NCE_PASS6=
# NCE Pass Guarantee (one-time). Leave empty to keep the guarantee off sale.
STRIPE_PRICE_NCE_GUARANTEE=
# NCE free trial in days, counted from the account's first visit to NCE
# study (not signup). Defaults to TRIAL_DAYS.
NCE_TRIAL_DAYS=
# Optional model override for the admin NCE question generator
# (routes/adminNce.js). Defaults to ANTHROPIC_MODEL / the case tools' model.
NCE_GEN_MODEL=
