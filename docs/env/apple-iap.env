# PassReady Prep — App Store In-App Purchase environment (iOS app)
#
# Import into Render: the service → Environment → "Add from .env" → paste
# this file. Locally: append it to your .env. Fill the blanks before
# importing; every key is documented in .env.example.
#
# Nothing here is secret except what you type into APPLE_APP_ID's
# neighbours below (there are no Apple secrets at all: signed transactions
# are verified with Apple's public root certificates).

# REQUIRED. The app's numeric Apple ID: App Store Connect → PassReady Prep →
# App Information → General Information → "Apple ID" (a 10-digit number).
# In-app purchases stay switched off in the app until this is set.
APPLE_APP_ID=

# Bundle ID of the iOS app; also the prefix of every In-App Purchase
# product ID (com.gaitp.passreadyprep.ncmhce.monthly, ….ncmhce.pass3,
# ….ncmhce.guarantee, ….guide, ….nce.monthly, ….nce.pass3, ….nce.pass6,
# ….nce.guarantee). Leave as is unless the products were created under
# a different prefix.
APPLE_IAP_BUNDLE_ID=com.gaitp.passreadyprep
APPLE_IAP_PRODUCT_PREFIX=com.gaitp.passreadyprep

# Optional — defaults are right for production:
# Folder with Apple's root certificates (node tools/apple/fetch-root-certs.js
# saves them to certs/apple; downloaded from apple.com on first use if empty).
APPLE_ROOT_CA_DIR=
# 0 = skip OCSP revocation checks (default 1, on).
APPLE_IAP_ONLINE_CHECKS=
# 0 = reject sandbox purchases. Leave unset: App Review and TestFlight buy in
# the sandbox, and sandbox accounts can only be created by us.
APPLE_IAP_ALLOW_SANDBOX=
# 1 = sell the NCE Pass Guarantee in the app before STRIPE_PRICE_NCE_GUARANTEE exists.
APPLE_IAP_OFFER_NCE_GUARANTEE=
