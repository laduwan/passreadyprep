# PassReady Prep — App Store In-App Purchase environment (iOS app)
#
# Import into Render: the service → Environment → "Add from .env" → paste
# this file. Locally: append it to your .env. Only APPLE_APP_ID needs a
# value from you; everything else is already set to its production value.
# Every key is documented in .env.example.

# REQUIRED. The app's numeric Apple ID (a 10-digit number): App Store Connect
# → PassReady Prep → App Information → General Information → "Apple ID".
# In-app purchases stay switched off in the app until this is set.
APPLE_APP_ID=

# Bundle ID of the iOS app; also the prefix of every In-App Purchase product
# ID (com.gaitp.passreadyprep.ncmhce.monthly, ….ncmhce.pass3,
# ….ncmhce.guarantee, ….guide, ….nce.monthly, ….nce.pass3, ….nce.pass6,
# ….nce.guarantee).
APPLE_IAP_BUNDLE_ID=com.gaitp.passreadyprep
APPLE_IAP_PRODUCT_PREFIX=com.gaitp.passreadyprep

# Folder with Apple's root certificates, relative to the server root
# (node tools/apple/fetch-root-certs.js saves them there; if the folder is
# empty they are downloaded from apple.com on first use).
APPLE_ROOT_CA_DIR=certs/apple

# 1 = check Apple's certificates for revocation (OCSP) on each verification.
APPLE_IAP_ONLINE_CHECKS=1

# 1 = accept sandbox purchases. Needed: App Review and TestFlight buy in the
# sandbox, and sandbox accounts can only be created by us.
APPLE_IAP_ALLOW_SANDBOX=1

# 0 = the NCE Pass Guarantee goes on sale in the app only once
# STRIPE_PRICE_NCE_GUARANTEE is set (same as the website). 1 = sell it now.
APPLE_IAP_OFFER_NCE_GUARANTEE=0
