# Copy to fastlane/.env (gitignored) and fill in. Never commit the real file.

# App Store Connect API key (Users and Access → Integrations → App Store Connect API)
ASC_KEY_ID=
ASC_ISSUER_ID=
# The downloaded AuthKey_XXXX.p8 — keep it outside the repo
ASC_KEY_PATH=~/.appstoreconnect/AuthKey.p8

# App Review contact + demo account (shown only to Apple's reviewer)
REVIEW_FIRST_NAME=
REVIEW_LAST_NAME=
REVIEW_PHONE=
REVIEW_EMAIL=
REVIEW_DEMO_USER=
REVIEW_DEMO_PASSWORD=
